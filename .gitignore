```gitignore
# Compiled and build artifacts
*.tsbuildinfo
dist/
build/
*.js
*.js.map
*.d.ts

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Coverage and test reports
coverage/
.nyc_output/
istanbul/
test-report.xml
```